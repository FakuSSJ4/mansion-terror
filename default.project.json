{
  "name": "mansion-terror",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "EnableMouseLockOption": false,
        "CameraMode": "LockFirstPerson",
        "CharacterJumpPower": 0,
        "CharacterJumpHeight": 0
      },
      "StarterCharacterScripts": {
        "$className": "StarterCharacterScripts"
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      },
      "Terrain": {
        "$properties": {
          "Decoration": true
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "ShadowMap"
      }
    }
  }
}
