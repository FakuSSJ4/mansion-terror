--!strict
local Systems = script:WaitForChild("Systems")

local DebugTools = require(Systems:WaitForChild("DebugTools"))
local Entrance = require(Systems:WaitForChild("Entrance"))
local Escape = require(Systems:WaitForChild("Escape"))
local Flashlight = require(Systems:WaitForChild("Flashlight"))
local Killer = require(Systems:WaitForChild("Killer"))
local Lobby = require(Systems:WaitForChild("Lobby"))
local LobbyMap = require(Systems:WaitForChild("LobbyMap"))
local Mansion = require(Systems:WaitForChild("Mansion"))
local Profile = require(Systems:WaitForChild("Profile"))
local Round = require(Systems:WaitForChild("Round"))
local TaserSystem = require(Systems:WaitForChild("TaserSystem"))
local Vitality = require(Systems:WaitForChild("Vitality"))
local Weather = require(Systems:WaitForChild("Weather"))

local refs = Mansion.build()
Weather.start()
Profile.start()
-- El lobby se arma antes de que entre nadie: ahí aparecen todos al conectarse.
local lobbyRefs = LobbyMap.build()
Vitality.setLobbySpawn(lobbyRefs.spawns[1])
Vitality.start()
Round.setLobbySpawn(lobbyRefs.spawns[1])
Round.start(refs)
Lobby.start(lobbyRefs)
Killer.start(refs)
Entrance.start(refs)
Escape.start(refs)
TaserSystem.start()
Flashlight.start()
DebugTools.start(refs)
